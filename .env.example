APP_NAME=Aroma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aroma
DB_USERNAME=root
DB_PASSWORD=

# Local defaults run without extra services. In production switch these to
# "redis" (set REDIS_CLIENT=predis unless the phpredis extension is installed).
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@aroma.sa
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3 compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment gateways (Saudi market)
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_BASE_URL=https://api-sandbox.tamara.co
TAMARA_PUBLIC_KEY=
TAMARA_WIDGET_URL=
TAMARA_SHIPPING_COMPANY="Aroma Delivery"
TAMARA_ELIGIBILITY_TIMEOUT_MS=800

# Notifications: SMS + WhatsApp
SMS_PROVIDER=unifonic
SMS_API_KEY=
SMS_SENDER_ID=Aroma
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI concierge (Google Gemini) — widget degrades gracefully if unset
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# National Address (Saudi Post / SPL) location-code lookup — leave both blank
# to run in stub mode (checkout/account addresses stay usable with canned data)
NATIONAL_ADDRESS_BASE_URL=
NATIONAL_ADDRESS_API_KEY=

# Floating WhatsApp button — digits incl. country code, e.g. 9665XXXXXXXX
# The button only appears once this is set.
AROMA_WHATSAPP=
AROMA_PHONE=

# Footer social icons — full profile URLs. Each icon falls back to "#" until set.
AROMA_INSTAGRAM=
AROMA_TIKTOK=
AROMA_SNAPCHAT=
AROMA_FACEBOOK=
