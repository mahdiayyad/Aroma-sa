APP_NAME=Aroma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aroma
DB_USERNAME=root
DB_PASSWORD=

# Local defaults run without extra services. In production switch these to
# "redis" (set REDIS_CLIENT=predis unless the phpredis extension is installed).
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_FROM_ADDRESS=no-reply@aroma.sa
MAIL_FROM_NAME="${APP_NAME}"

# SMTP fallback — only read when MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Object storage (S3 compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment gateways (Saudi market)
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# The Secret Token entered for the webhook in Moyasar Dashboard → Settings → Webhooks
MOYASAR_WEBHOOK_SECRET=
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_BASE_URL=https://api-sandbox.tamara.co
TAMARA_PUBLIC_KEY=
TAMARA_WIDGET_URL=
TAMARA_SHIPPING_COMPANY="Aroma Delivery"
TAMARA_ELIGIBILITY_TIMEOUT_MS=800

# Aramex
#   Production: https://ws.aramex.net/ShippingAPI.V2
#   UAT:        http://ws.uat.aramex.net/shippingapi  (Aramex must whitelist
#               the calling server's public IP; test accounts are in
#               Aramex's "UAT JED&RUH" document, entity RUH or JED)
# The Shipping API login is separate from the aramex.com website login.
# Check the setup with: php artisan aramex:check
ARAMEX_BASE_URL=https://ws.sbx.aramex.net/ShippingAPI.V2
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
# Aramex office that owns the account, e.g. RUH or JED; confirm with Aramex.
ARAMEX_ACCOUNT_ENTITY=DHA
ARAMEX_ACCOUNT_COUNTRY_CODE=SA
# 24 is the source id in Aramex's own shipment-creation sample.
ARAMEX_SOURCE=24
# Shared key Aramex sends as the x-api-key header on push tracking updates to
# https://<your-domain>/webhooks/aramex. Generate one, give it to Aramex:
#   php -r "echo bin2hex(random_bytes(32));"
ARAMEX_WEBHOOK_SECRET=
ARAMEX_DEFAULT_ITEM_WEIGHT_KG=1.0
ARAMEX_DOMESTIC_PRODUCT_TYPE=CDS
ARAMEX_INTERNATIONAL_PRODUCT_TYPE=EPX
ARAMEX_SHIPPER_NAME=Aroma
ARAMEX_SHIPPER_COMPANY="Aroma Gift Center"
ARAMEX_SHIPPER_PHONE=
ARAMEX_SHIPPER_EMAIL=
ARAMEX_SHIPPER_ADDRESS_LINE1=
ARAMEX_SHIPPER_ADDRESS_LINE2=
ARAMEX_SHIPPER_CITY=
ARAMEX_SHIPPER_POST_CODE=
ARAMEX_SHIPPER_COUNTRY_CODE=SA

# Flat shipping fallback used ONLY if a live Aramex rate call fails/is
# unconfigured — checkout must never hard-block on a carrier outage. Real
# business figures, not a code default: confirm before deploy.
AROMA_SHIPPING_FLAT_RATE_DOMESTIC=0.0
AROMA_SHIPPING_FLAT_RATE_INTERNATIONAL=0.0

# Phone-number login: Tawked Verify API (tk_test_ = sandbox, tk_live_ = production)
TAWKED_BASE_URL=https://tawked.com
TAWKED_API_KEY=
TAWKED_TIMEOUT=10
# Local development only (ignored in every other APP_ENV): a fixed OTP code that
# skips the Tawked call entirely, so dev doesn't burn sandbox/paid sends.
TAWKED_DEV_CODE=

# Notifications: WhatsApp
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI concierge (Google Gemini) — widget degrades gracefully if unset
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# National Address (Saudi Post / SPL) location-code lookup — leave both blank
# to run in stub mode (checkout/account addresses stay usable with canned data)
NATIONAL_ADDRESS_BASE_URL=
NATIONAL_ADDRESS_API_KEY=
# Demo address data while no real API is configured (development only; never in production)
NATIONAL_ADDRESS_DEMO=false

# Floating WhatsApp button — digits incl. country code, e.g. 9665XXXXXXXX
# The button only appears once this is set.
AROMA_WHATSAPP=
AROMA_PHONE=

# Footer social icons — full profile URLs. Each icon stays hidden until set.
AROMA_INSTAGRAM=
AROMA_TIKTOK=
AROMA_SNAPCHAT=
AROMA_FACEBOOK=

# Ad pixels (loaded in production only). Leave unset to use the IDs in
# config/aroma.php; set one to empty to turn that pixel off.
# META_PIXEL_ID=
# TIKTOK_PIXEL_ID=

# Shown in the footer once set (the VAT number also appears on receipts).
AROMA_FREELANCE_DOCUMENT=
AROMA_VAT_NUMBER=

# Product import / export (see docs/product-import-export)
AROMA_IMPORT_MAX_UPLOAD_MB=10
AROMA_IMPORT_SYNC_MAX_ROWS=100
AROMA_IMPORT_SYNC_MAX_IMAGES=25
AROMA_IMPORT_QUEUE=imports
QUEUE_RETRY_AFTER=1900
